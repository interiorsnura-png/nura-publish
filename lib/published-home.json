{"html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"description\" content=\"Design your bespoke kitchen or joinery with Nura. A considered, end-to-end process for homes in London and Dubai.\">\n  <meta name=\"theme-color\" content=\"#1e211d\">\n  <meta property=\"og:title\" content=\"Nura \u2014 Bespoke kitchens & joinery\">\n  <meta property=\"og:description\" content=\"Design-led kitchens and joinery, made with intention.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://www.nura-interiors.com/\">\n  <meta property=\"og:image\" content=\"https://www.nura-interiors.com/assets/selected/nura-hero-shot.jpeg\">\n  <meta property=\"og:image:alt\" content=\"Light-filled kitchen with a central island and timber cabinetry\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Nura \u2014 Bespoke kitchens & joinery\">\n  <meta name=\"twitter:description\" content=\"Design-led kitchens and joinery, made with intention.\">\n  <meta name=\"twitter:image\" content=\"https://www.nura-interiors.com/assets/selected/nura-hero-shot.jpeg\">\n  <link rel=\"canonical\" href=\"https://www.nura-interiors.com/\">\n  <title>Nura \u2014 Bespoke kitchens & joinery</title>\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Nura\",\"description\":\"Bespoke kitchens and joinery for considered homes.\",\"areaServed\":[\"London\",\"Dubai\"],\"email\":\"studio@nura-interiors.com\",\"url\":\"https://www.nura-interiors.com/\",\"image\":\"https://www.nura-interiors.com/assets/selected/nura-hero-shot.jpeg\",\"serviceType\":[\"Bespoke kitchens\",\"Bespoke joinery\",\"Complete-home interiors\"]}</script>\n  <link rel=\"stylesheet\" href=\"nura-home.css\">\n  <script defer src=\"nura-home.js\"></script>\n</head>\n<body>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"#top\" aria-label=\"Nura home\"><img src=\"assets/nura-wordmark.svg\" alt=\"Nura\" width=\"112\" height=\"42\"></a>\n  <nav class=\"desktop-nav\" aria-label=\"Main navigation\"><a href=\"#work\">Work</a><a href=\"#approach\">Approach</a><a href=\"#services\">Services</a><a href=\"#contact\">Contact</a></nav>\n  <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-menu\"><span>Menu</span><i aria-hidden=\"true\"></i></button>\n  <nav id=\"site-menu\" class=\"site-nav\" aria-label=\"Mobile navigation\"><a href=\"#work\">Work</a><a href=\"#approach\">Approach</a><a href=\"#services\">Services</a><a href=\"#contact\">Contact</a></nav>\n</header>\n<main id=\"top\">\n  <section class=\"hero\" aria-labelledby=\"hero-title\"><img class=\"hero-image\" width=\"1600\" height=\"1184\" src=\"assets/selected/nura-hero-shot.jpeg\" alt=\"Light-filled kitchen with a central island, timber cabinetry and open shelving\" fetchpriority=\"high\"><div class=\"hero-aurora\" aria-hidden=\"true\"></div><div class=\"hero-shade\"></div><div class=\"hero-copy hero-enter\"><p class=\"eyebrow\">London \u00b7 Dubai \u00b7 Bespoke interiors</p><h1 id=\"hero-title\">A room can<br><em>change a life.</em></h1><p class=\"hero-lede\">Kitchens and joinery made around the way you live, with a quiet confidence that lasts.</p><a class=\"button button-light\" href=\"#contact\">Begin a conversation <span>\u2197</span></a><p class=\"hero-trust\">Design-led \u00b7 Made to last \u00b7 London & Dubai</p></div><div class=\"hero-foot\"><span>Scroll to explore</span><span>01 \u2014 06</span></div></section>\n\n  <section id=\"approach\" class=\"manifesto section-pad reveal\"><div class=\"section-mark\">The Nura way</div><div class=\"manifesto-grid\"><div class=\"approach-image\"><img width=\"1228\" height=\"1800\" src=\"assets/selected/nura-approach-new.jpg\" alt=\"Bespoke kitchen with warm stone surfaces, ribbed timber cabinetry and a sculptural glass pendant light\" loading=\"lazy\"></div><div class=\"approach-copy\"><h2>Not made for everyone.<br><em>Made for you.</em></h2><p>We design spaces that feel inevitable: considered from the first line, resolved down to the last hinge.</p><p>Our work sits between architecture and everyday life. It is tactile, practical and quietly expressive.</p><a class=\"text-link\" href=\"#process\">How we work <span>\u2198</span></a></div></div><div class=\"proof-row\"><div><strong>01</strong><span>One studio</span><small>Design through installation</small></div><div><strong>02</strong><span>Two cities</span><small>London and Dubai</small></div><div><strong>\u221e</strong><span>No standard answers</span><small>Every space begins again</small></div></div><div class=\"trust-strip\"><span>Designed around your life</span><span>Made with lasting materials</span><span>Managed from brief to installation</span></div></section>\n\n  <section id=\"work\" class=\"work section-pad reveal\"><div class=\"section-top\"><div class=\"section-mark\">Selected work</div><div class=\"section-note\">Three homes, three different ways to live.</div></div><div class=\"project-grid\"><a class=\"project-card project-card-tall\" href=\"projects-hampstead-house.html\"><img width=\"1333\" height=\"2000\" src=\"assets/selected/elm-park-road.jpg\" alt=\"Elm Park Road kitchen with warm oak cabinetry, marble worktop and island seating\" loading=\"lazy\"><span class=\"project-meta\"><b>Elm Park Road</b><small>London \u00b7 Bespoke kitchen</small><i>View project \u2197</i></span></a><a class=\"project-card\" href=\"projects-park-view.html\"><img width=\"2000\" height=\"2000\" src=\"assets/selected/tansley-farm.jpg\" alt=\"Tansley Farm kitchen detail with white cabinetry, brass trim and tactile control dials\" loading=\"lazy\"><span class=\"project-meta\"><b>Tansley Farm</b><small>London \u00b7 Bespoke kitchen</small><i>View project \u2197</i></span></a><a class=\"project-card\" href=\"projects-clay-house.html\"><img width=\"1334\" height=\"2000\" src=\"assets/selected/westover-road.webp\" alt=\"Westover Road joinery with illuminated shelving, dark timber and marble surfaces\" loading=\"lazy\"><span class=\"project-meta\"><b>Westover Road</b><small>London \u00b7 Bespoke joinery</small><i>View project \u2197</i></span></a></div><a class=\"text-link work-link\" href=\"#contact\">Discuss your space <span>\u2197</span></a><article class=\"featured-study\"><div class=\"featured-study-image\"><img width=\"1600\" height=\"900\" src=\"assets/selected/nura-featured-study.jpg\" alt=\"Contemporary kitchen interior with pale stone surfaces and dark cabinetry\" loading=\"lazy\"></div><div class=\"featured-study-copy\"><div class=\"section-mark\">A considered interior study</div><h2>Architecture,<br><em>held in detail.</em></h2><p>A visual study in proportion, material contrast and the rituals that make a kitchen feel like home.</p><a class=\"text-link\" href=\"#contact\">Discuss a similar direction <span>\u2197</span></a></div></article></section>\n\n  <section id=\"services\" class=\"services section-pad reveal\"><div class=\"section-mark\">What we make</div><div class=\"services-intro\"><h2>One language,<br><em>many rooms.</em></h2><p>From a single kitchen to a whole home, we bring the same care to every surface, junction and moment.</p></div><div class=\"service-list\"><article><span>01</span><div><h3>Kitchens</h3><p>Bespoke cabinetry, islands and material palettes shaped around your rituals.</p></div><a href=\"#contact\" aria-label=\"Enquire about kitchens\">\u2197</a></article><article><span>02</span><div><h3>Joinery</h3><p>Wardrobes, libraries, media walls and storage that belong to the architecture.</p></div><a href=\"#contact\" aria-label=\"Enquire about joinery\">\u2197</a></article><article><span>03</span><div><h3>Complete homes</h3><p>A continuous design language from entrance hall to final detail.</p></div><a href=\"#contact\" aria-label=\"Enquire about complete homes\">\u2197</a></article></div></section>\n\n  <section id=\"process\" class=\"process reveal\"><div class=\"process-art\"><img width=\"1448\" height=\"1086\" src=\"assets/selected/nura-process-workshop.webp\" alt=\"Bespoke joinery workshop with timber materials, machinery and production benches\"></div><div class=\"process-intro\"><div><div class=\"section-mark\">From idea to installation</div><h2>Clear path<br><em>To something lasting.</em></h2></div><div class=\"process-intro-copy\"><p>Good work takes conversation, care and clear process.</p><a class=\"text-link\" href=\"#contact\">Request a consultation <span>\u2198</span></a></div></div><ol class=\"process-steps\"><li><span class=\"process-step-number\">01</span><h3>Listen</h3><p>We begin by understanding how you live, what matters to you and what space needs to achieve.</p></li><li><span class=\"process-step-number\">02</span><h3>Shape</h3><p>We refine layout, materials, details and practical decisions into clear design direction.</p></li><li><span class=\"process-step-number\">03</span><h3>Make</h3><p>We manufacture, coordinate and install the project with close attention to detail.</p></li></ol></section>\n\n<section class=\"proof-section section-pad reveal\" aria-labelledby=\"proof-title\"><div class=\"section-mark\">What the process gives you</div><div class=\"proof-heading\"><h2 id=\"proof-title\">Clarity before<br><em>commitment.</em></h2><p>A Nura project is designed to make important decisions feel easier\u2014not more complicated.</p></div><div class=\"outcome-grid\"><article><strong>01</strong><h3>A brief with direction</h3><p>We turn ideas, references and practical needs into a shared point of view.</p></article><article><strong>02</strong><h3>Materials you can trust</h3><p>We explain the choices, trade-offs and care behind every finish.</p></article><article><strong>03</strong><h3>A room that belongs</h3><p>The result is made for your routines, your architecture and the years ahead.</p></article></div></section>\n\n  <section class=\"styles section-pad reveal\"><div class=\"section-mark\">Find your direction</div><div class=\"styles-head\"><h2>Which way<br><em>will you live?</em></h2><p>There is no Nura look. There is only the right response to your home.</p></div><div class=\"style-grid\"><div><img width=\"1500\" height=\"2000\" src=\"assets/selected/FHuma01.webp\" alt=\"Warm timber kitchen with green stone worktop and garden view\" loading=\"lazy\"><span>Warm & tactile</span></div><div><img width=\"2000\" height=\"1335\" src=\"assets/selected/P1176661-HDR-edited.jpg\" alt=\"Detailed kitchen drawer with timber storage and integrated controls\" loading=\"lazy\"><span>Material & detail</span></div><div><img width=\"1335\" height=\"2000\" src=\"assets/selected/Copy-of-DSC-0978.jpg\" alt=\"Ribbed timber kitchen cabinetry with green stone sink and window light\" loading=\"lazy\"><span>Light & considered</span></div></div></section>\n\n  <section class=\"world reveal\"><div class=\"world-image\"><img width=\"1743\" height=\"4360\" src=\"assets/selected/nura-cta-joinery.jpg\" alt=\"Bespoke joinery detail with a stone worktop and integrated sink\" loading=\"lazy\"></div><div class=\"world-copy\"><div class=\"section-mark\">Two places, one point of view</div><h2>Made here.<br><em>At home anywhere.</em></h2><p>We work across London and Dubai, bringing an attentive, design-led process to homes with a point of view.</p><div class=\"location-links\"><a href=\"mailto:studio@nura-interiors.com?subject=London%20studio%20enquiry\"><strong>London</strong><span>Residential studio \u00b7 Email us \u2197</span></a><a href=\"mailto:studio@nura-interiors.com?subject=Dubai%20studio%20enquiry\"><strong>Dubai</strong><span>Residential studio \u00b7 Email us \u2197</span></a></div></div></section>\n\n  <section class=\"for-pros section-pad reveal\"><div><div class=\"section-mark\">For architects & designers</div><h2>A considered<br><em>partner in the room.</em></h2></div><div><p>We collaborate with architects, interior designers and developers to make the joinery feel native to the project.</p><a class=\"text-link\" href=\"mailto:studio@nura-interiors.com?subject=Professional%20enquiry\">Talk to our studio <span>\u2197</span></a></div></section>\n\n<section class=\"faq section-pad reveal\" aria-labelledby=\"faq-title\"><div class=\"section-mark\">Before we begin</div><div class=\"faq-heading\"><h2 id=\"faq-title\">Questions worth<br><em>asking early.</em></h2><p>A few practical answers before you tell us about your project.</p></div><div class=\"faq-list\"><details><summary>What kind of projects does Nura take on?</summary><p>We design bespoke kitchens, joinery and complete-home interiors for private clients, architects and designers in London and Dubai.</p></details><details><summary>Can you work with my architect or interior designer?</summary><p>Yes. We regularly collaborate with design teams, developing the joinery and details alongside the wider architecture.</p></details><details><summary>What happens after I enquire?</summary><p>We review your brief and reply with a considered next step. If the project is a fit, we arrange an initial conversation about scope, timing and direction.</p></details><details><summary>Do you work outside London and Dubai?</summary><p>Our studios are based in London and Dubai. For projects elsewhere, tell us about the location and we will let you know what is possible.</p></details></div></section>\n\n  <section id=\"contact\" class=\"contact section-pad reveal\"><div class=\"section-mark\">Begin a conversation</div><div class=\"contact-grid\"><div><h2>Let\u2019s make<br><em>something lasting.</em></h2><p>Tell us about your home, your location and what matters to you. We\u2019ll reply with a considered next step.</p></div><form class=\"enquiry-form\" data-enquiry-form data-endpoint=\"/_functions/enquiry\" method=\"post\" action=\"/_functions/enquiry\"><input type=\"hidden\" name=\"utm_source\"><input type=\"hidden\" name=\"utm_medium\"><input type=\"hidden\" name=\"utm_campaign\"><label>Name<input name=\"name\" autocomplete=\"name\" required></label><label>Email<input type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label>Location <span class=\"optional-label\">Optional</span><input name=\"location\" placeholder=\"London or Dubai\"></label><label>Project type <span class=\"optional-label\">Optional</span><select name=\"projectType\"><option value=\"\">Select one</option><option>Bespoke kitchen</option><option>Full-home joinery</option><option>Complete home</option><option>Architect / designer collaboration</option></select></label><label>Budget range <span class=\"optional-label\">Optional</span><select name=\"budget\"><option value=\"\">Prefer not to say</option><option>\u00a325k\u2013\u00a350k</option><option>\u00a350k\u2013\u00a3100k</option><option>\u00a3100k+</option><option>Dubai project \u2014 discuss in AED</option></select></label><label>Tell us about your project<textarea name=\"message\" rows=\"4\" required></textarea></label><button class=\"button\" type=\"submit\">Start the conversation <span>\u2197</span></button><p class=\"form-note\">A considered reply from the studio. No automated sales sequence.</p><p class=\"form-status\" role=\"status\" aria-live=\"polite\"></p></form></div></section>\n</main>\n<footer class=\"site-footer\"><div class=\"footer-top\"><img src=\"assets/nura-wordmark.svg\" alt=\"Nura\" width=\"112\"><p>Bespoke kitchens and joinery<br>for considered homes.</p><a class=\"text-link text-link-light\" href=\"#top\">Back to top <span>\u2191</span></a></div><div class=\"footer-bottom\"><div><small>Studios</small><p>London \u00b7 Dubai</p></div><div><small>Write to us</small><p><a href=\"mailto:studio@nura-interiors.com\">studio@nura-interiors.com</a></p></div><div><small>For professionals</small><p><a href=\"mailto:studio@nura-interiors.com?subject=Professional%20enquiry\">Trade enquiries</a></p></div><p class=\"copyright\">\u00a9 2026 Nura Interiors</p></div></footer>\n</body></html>\n"}